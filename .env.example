# ==============================================================================
# ARIA AI Companion — Environment Configuration Template (.env.example)
#
# Quick setup:
#   1. Copy this file to `backend/.env` (or `.env` in project root for Docker):
#        cp .env.example backend/.env
#   2. Replace `your_gemini_api_key_here` with your Google Gemini API key.
#      Get an API key from Google AI Studio: https://aistudio.google.com/
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API Configuration (Required)
# ------------------------------------------------------------------------------
# Your Google Gemini API Key. Keep this secret and never commit your real key!
GEMINI_API_KEY=your_gemini_api_key_here

# Dialogue model for companion reasoning and response generation
GEMINI_MODEL=gemini-3.5-flash-lite

# HTTP timeout in seconds for Gemini API generation requests
GEMINI_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# 2. Text-to-Speech (TTS) Configuration
# ------------------------------------------------------------------------------
# Enable or disable real-time voice synthesis (falls back gracefully to text)
TTS_ENABLED=true

# Gemini TTS audio model identifier
TTS_MODEL=gemini-3.8-flash-lite-tts

# Aria voice timbre (Sulafat: warm/expressive female tone)
TTS_VOICE=Sulafat

# TTS generation timeout in seconds before falling back to text-only mode
TTS_TIMEOUT_SECONDS=15.0

# ------------------------------------------------------------------------------
# 3. Application Server & Networking
# ------------------------------------------------------------------------------
# Host interface to bind on (127.0.0.1 for local security)
APP_HOST=127.0.0.1

# Application port for the FastAPI server
APP_PORT=8000

# Allowed CORS origins for browser security (JSON array or comma-separated)
ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# 4. Session Storage & Dialogue History
# ------------------------------------------------------------------------------
# In-memory session idle time-to-live in seconds (7200s = 2 hours)
SESSION_TTL_SECONDS=7200

# Maximum past dialogue turns retained in prompt history context
MAX_HISTORY_MESSAGES=12

