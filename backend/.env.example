# ==============================================================================
# Google Gemini AI Companion — Backend Environment Configuration Example
# Copy this file to `backend/.env` and provide your Google Gemini API Key.
# ==============================================================================

# Your Google Gemini API Key (keep this private, do NOT commit actual keys)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Dialogue Model Identifier
GEMINI_MODEL=gemini-3.5-flash-lite

# Timeout for Gemini conversational requests in seconds
GEMINI_TIMEOUT_SECONDS=30.0

# Real-Time Voice Synthesis Configuration
TTS_ENABLED=true
TTS_MODEL=gemini-3.8-flash-lite-tts
TTS_VOICE=Sulafat
TTS_TIMEOUT_SECONDS=15.0

# Application Server Host and Port
APP_HOST=127.0.0.1
APP_PORT=8000

# Allowed CORS Origins (comma-separated or JSON list)
ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# In-Memory Session Storage Settings
SESSION_TTL_SECONDS=7200
MAX_HISTORY_MESSAGES=12

